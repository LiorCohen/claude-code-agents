cli_delegation: {
  shape: sequence_diagram

  User
  Core: sdd-core CLI
  FS: .sdd/tech-packs.yaml
  TP: tech-pack.yaml
  TPCLI: Tech Pack CLI

  User -> Core: sdd-system fullstack-ts database setup my-db
  Core -> Core: "parse arg[0]: fullstack-ts, not a core namespace"
  Core -> FS: read .sdd/tech-packs.yaml
  FS -> Core: manifest: .claude/plugins/sdd-fullstack-ts/tech-pack.yaml
  Core -> TP: read tech-pack.yaml
  TP -> Core: requires_sdd_core: ">=8.0.0", cli_entry_point: system/dist/cli.js
  Core -> Core: version check: 8.0.0 >= 8.0.0
  Core -> TPCLI: spawn subprocess — node system/dist/cli.js database setup my-db
  TPCLI -> TPCLI: "parse: group=database, action=setup, args=[my-db]"
  TPCLI -> TPCLI: execute handler
  TPCLI -> Core: exit code 0
  Core -> User: forward output + exit code
}
