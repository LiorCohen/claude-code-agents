direction: right

core: sdd-core {
  style.fill: "#e1f5fe"
  init: Init Orchestrator
  cli: CLI Router
  scaffold: Scaffolding Engine
  settings: Settings Engine
  hooks_runner: Hook Runner
  prompts: Core Skills/Commands
  schema: tech-pack.schema.json
}

contract: Contract Layer {
  style.fill: "#fffde7"
  tpy: tech-pack.yaml
  tpyaml: ".sdd/tech-packs.yaml"
  sdds: ".sdd/sdd-settings.yaml"
}

tp: Tech Pack {
  style.fill: "#fff3e0"
  tp_cli: Tech Pack CLI
  tp_skills: Skills + Agents
  tp_templates: Templates
  tp_schemas: Settings Schemas
}

core.init -> contract.tpy: 1. reads
core.init -> contract.tpyaml: 1. writes
core.init -> contract.sdds: 1. writes
core.cli -> contract.tpyaml: 2. reads
core.cli -> tp.tp_cli: 2. spawns
core.settings -> contract.sdds: 3,4. reads/writes
core.settings -> tp.tp_schemas: 4. validates against
core.scaffold -> contract.tpy: 5. reads
core.scaffold -> tp.tp_templates: 5. copies
core.hooks_runner -> contract.tpy: 7. reads
core.schema -> contract.tpy: validates
core.prompts -> tp.tp_skills: 6. LLM context {
  style.stroke-dash: 5
}
