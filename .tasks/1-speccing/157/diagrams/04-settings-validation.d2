validation: {
  shape: sequence_diagram

  User
  Core: sdd-core CLI
  Settings: sdd-settings.yaml
  TP: tech-pack.yaml
  Schema: "schemas/*.json"

  User -> Core: sdd-system settings reconcile
  Core -> Settings: read sdd-settings.yaml
  Core -> Core: validate core envelope (sdd, project, system)

  for each tech pack: {
    Core -> TP: read tech-pack.yaml (follow manifest pointer)
    TP -> Core: "component_types with settings_schema paths"

    for each component: {
      Core -> Schema: load JSON schema for component type
      Schema -> Core: server-settings.json
      Core -> Core: validate component.settings against schema
    }
  }

  Core -> User: settings valid (or errors scoped to tech pack namespace)
}
